# FinTaxVers Environment Variables
# Copy this file to .env.local (for development) and fill in your values.
# NEVER commit real secrets to git.

# ================================
# Firebase (existing - required)
# ================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ================================
# EmailJS (existing - optional)
# ================================
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ================================
# AI / LLM Provider (server-side only)
# Supports: openai, gemini
# ================================
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_or_gemini_api_key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# ================================
# Embeddings (server-side only)
# Defaults to LLM_API_KEY if not set
# ================================
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=text-embedding-3-small

# ================================
# RAG Configuration
# ================================
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.55
RAG_FALLBACK_MESSAGE=I'm unable to find specific information about that right now. For accurate guidance, please contact the FinTaxVers team at +91-8928895195 or contact@fintaxvers.com

# ================================
# WhatsApp Business Cloud API
# (server-side only - NEVER expose in frontend)
# Get from Meta Developer Console:
# https://developers.facebook.com
# ================================
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=fintaxvers_webhook_verify_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret

# ================================
# Server Configuration
# ================================
PORT=5000
NODE_ENV=development

# Admin API security token (set a strong random string)
ADMIN_API_TOKEN=your_secure_admin_token_here

# Handoff token expiry in seconds (default 1 hour)
HANDOFF_TOKEN_EXPIRY_SECONDS=3600

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ================================
# Site URL
# ================================
VITE_SITE_URL=https://fintaxvers.com